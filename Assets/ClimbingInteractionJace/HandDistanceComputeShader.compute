#pragma kernel CSMain

RWStructuredBuffer<float4> vertexContactData;
RWStructuredBuffer<int4> tipContactStats;
RWStructuredBuffer<uint> handBoneToHoldMinDistances;

StructuredBuffer<float3> climbingHoldVertices;
StructuredBuffer<float3> climbingHoldNormals;
StructuredBuffer<float> climbingHoldVertexAreas;
StructuredBuffer<float3> leftHandBones;
StructuredBuffer<float3> rightHandBones;

float4x4 _LocalToWorld;
float4x4 _NormalToWorld;
float _ContactThreshold;
float _FixedPointScale;
int _VertexCount;
int _BoneCount;
int _HandMask;

int FingertipOrdinal(int boneIndex)
{
    int ordinal = -1;
    if (boneIndex == 5) ordinal = 0;
    else if (boneIndex == 10) ordinal = 1;
    else if (boneIndex == 15) ordinal = 2;
    else if (boneIndex == 20) ordinal = 3;
    else if (boneIndex == 25) ordinal = 4;
    return ordinal;
}

[numthreads(128, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VertexCount) return;

    float3 vertexPosition = mul(_LocalToWorld, float4(climbingHoldVertices[id.x], 1.0)).xyz;
    float leftHandMinDistance = 3.402823466e+38;
    float rightHandMinDistance = 3.402823466e+38;
    float nearestTipDistance = 3.402823466e+38;
    int nearestTip = 10;

    if ((_HandMask & 1) != 0)
    {
        for (int leftIndex = 0; leftIndex < _BoneCount; leftIndex++)
        {
            float vertexDistance = distance(vertexPosition, leftHandBones[leftIndex]);
            leftHandMinDistance = min(leftHandMinDistance, vertexDistance);
            InterlockedMin(handBoneToHoldMinDistances[leftIndex], asuint(vertexDistance));

            int ordinal = FingertipOrdinal(leftIndex);
            if (ordinal >= 0 && vertexDistance < nearestTipDistance)
            {
                nearestTipDistance = vertexDistance;
                nearestTip = ordinal;
            }
        }
    }

    if ((_HandMask & 2) != 0)
    {
        for (int rightIndex = 0; rightIndex < _BoneCount; rightIndex++)
        {
            float vertexDistance = distance(vertexPosition, rightHandBones[rightIndex]);
            rightHandMinDistance = min(rightHandMinDistance, vertexDistance);
            InterlockedMin(handBoneToHoldMinDistances[26 + rightIndex], asuint(vertexDistance));

            int ordinal = FingertipOrdinal(rightIndex);
            if (ordinal >= 0 && vertexDistance < nearestTipDistance)
            {
                nearestTipDistance = vertexDistance;
                nearestTip = 5 + ordinal;
            }
        }
    }

    if (nearestTip < 10 && nearestTipDistance <= _ContactThreshold)
    {
        float area = climbingHoldVertexAreas[id.x];
        float3 normal = normalize(mul((float3x3)_NormalToWorld, climbingHoldNormals[id.x]));
        int areaFixed = (int)max(1.0, round(area * _FixedPointScale));
        int3 normalFixed = (int3)round(normal * area * _FixedPointScale);
        InterlockedAdd(tipContactStats[nearestTip].x, areaFixed);
        InterlockedAdd(tipContactStats[nearestTip].y, normalFixed.x);
        InterlockedAdd(tipContactStats[nearestTip].z, normalFixed.y);
        InterlockedAdd(tipContactStats[nearestTip].w, normalFixed.z);
    }

    // UV2.xy preserves the original whole-hand heatmap. UV2.zw adds fingertip id and distance.
    vertexContactData[id.x] = float4(
        leftHandMinDistance,
        rightHandMinDistance,
        (float)nearestTip,
        nearestTipDistance);
}
